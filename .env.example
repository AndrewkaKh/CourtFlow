# Скопируйте в .env и при необходимости поменяйте значения.

HOST=127.0.0.1
PORT=8000
# Адрес, на который ЮKassa вернёт пользователя после оплаты
PUBLIC_URL=http://127.0.0.1:8000

# Оплата: mock — кнопка тестовой оплаты прямо на сайте (по умолчанию, ключи не нужны)
#         yookassa — тестовый магазин ЮKassa, нужны ключи из личного кабинета
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Номер счётчика Яндекс Метрики (пусто — Метрика не подключается)
METRIKA_ID=

# Сколько минут слот держится за пользователем, пока он оплачивает
HOLD_MINUTES=10
# На сколько дней вперёд можно бронировать
BOOKING_DAYS=14
# 1 — заполнять расписание демо-бронями, чтобы карта не была пустой
DEMO_SEED=1
TIMEZONE=Europe/Moscow
